[Unit]
Description=Nexus agent API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
WorkingDirectory=/agent
EnvironmentFile=/etc/agent-lab/agent.env
ExecStartPre=/bin/bash /agent/scripts/sync-api-deps.sh
ExecStart=/agent/.venv/bin/python -m uvicorn api:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
