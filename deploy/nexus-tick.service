[Unit]
Description=Nexus initiative tick (decide and start one piece of Nexus's own work)
After=network.target agent-api.service

[Service]
Type=oneshot
User=agent
WorkingDirectory=/agent
StateDirectory=nexus
EnvironmentFile=/etc/agent-lab/agent.env
Environment=AGENT_DB_PATH=/var/lib/nexus/agent.db
# The service's one-at-a-time gate and five-start rolling daily budget bound
# autonomous work. The full controller is required to plan and implement open
# issues after the integration backlog has drained.
ExecStart=/agent/.venv/bin/python /agent/nexus_tick.py --daily-budget 5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
