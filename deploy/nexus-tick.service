[Unit]
Description=Nexus initiative tick (decide and start one piece of Nexus's own work)
After=network.target agent-api.service

[Service]
Type=oneshot
User=agent
WorkingDirectory=/agent
StateDirectory=nexus
EnvironmentFile=/etc/agent-lab/agent.env
Environment=AGENT_DB_PATH=/var/lib/nexus/agent.db
# Claude watches this PR and is woken by each comment (#365).
Environment=NEXUS_NOTIFY_PR=tire0011/agent-lab-mailbox#6
# The service's one-at-a-time gate and rolling daily budget bound autonomous
# work. The budget is normally 5; it is 10 for one day (owner decision,
# 2026-10-26). The full controller is required to plan and implement open
# issues after the integration backlog has drained.
ExecStart=/agent/.venv/bin/python /agent/nexus_tick.py --daily-budget 10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
